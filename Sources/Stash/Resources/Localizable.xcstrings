          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "북마크를 가져오려면 Stash 브라우저 확장 프로그램을 설치하세요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้งส่วนขยายเบราว์เซอร์ Stash เพื่อนำเข้าบุ๊กมาร์ก"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت إضافة Stash للمتصفح لاستيراد الإشارات المرجعية"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बुकमार्क इंपोर्ट करने के लिए Stash ब्राउज़र एक्सटेंशन इंस्टॉल करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang ekstensi browser Stash untuk mengimpor bookmark"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài tiện ích trình duyệt Stash để nhập dấu trang"
          }
        }
      }
    },
    "Install the extension from the Chrome Web Store. It works in Chrome, Arc, Brave, Edge, Vivaldi and any Chromium browser.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установи расширение из Chrome Web Store. Оно работает в Chrome, Arc, Brave, Edge, Vivaldi и любом браузере на Chromium."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встанови розширення з Chrome Web Store. Воно працює в Chrome, Arc, Brave, Edge, Vivaldi і будь-якому браузері на Chromium."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstaluj rozszerzenie z Chrome Web Store. Działa w Chrome, Arc, Brave, Edge, Vivaldi i każdej przeglądarce na Chromium."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer de extensie via de Chrome Web Store. Hij werkt in Chrome, Arc, Brave, Edge, Vivaldi en elke Chromium-browser."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzantıyı Chrome Web Store'dan yükle. Chrome, Arc, Brave, Edge, Vivaldi ve tüm Chromium tarayıcılarında çalışır."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala la extensión desde la Chrome Web Store. Funciona en Chrome, Arc, Brave, Edge, Vivaldi y cualquier navegador Chromium."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale a extensão pela Chrome Web Store. Ela funciona no Chrome, Arc, Brave, Edge, Vivaldi e em qualquer navegador Chromium."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe l’extension depuis le Chrome Web Store. Elle fonctionne dans Chrome, Arc, Brave, Edge, Vivaldi et tout navigateur Chromium."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa l’estensione dal Chrome Web Store. Funziona in Chrome, Arc, Brave, Edge, Vivaldi e in ogni browser Chromium."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere die Erweiterung aus dem Chrome Web Store. Sie funktioniert in Chrome, Arc, Brave, Edge, Vivaldi und jedem Chromium-Browser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Chrome 应用商店安装扩展程序。它适用于 Chrome、Arc、Brave、Edge、Vivaldi 以及任何 Chromium 浏览器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 Chrome 線上應用程式商店安裝擴充功能。它適用於 Chrome、Arc、Brave、Edge、Vivaldi 及任何 Chromium 瀏覽器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome ウェブストアから拡張機能をインストールしてください。Chrome、Arc、Brave、Edge、Vivaldi など、すべての Chromium ブラウザで動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome 웹 스토어에서 확장 프로그램을 설치하세요. Chrome, Arc, Brave, Edge, Vivaldi 및 모든 Chromium 브라우저에서 작동합니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้งส่วนขยายจาก Chrome เว็บสโตร์ ใช้ได้ใน Chrome, Arc, Brave, Edge, Vivaldi และเบราว์เซอร์ Chromium ทุกตัว"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت الإضافة من Chrome Web Store. تعمل في Chrome وArc وBrave وEdge وVivaldi وأي متصفح Chromium."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सटेंशन Chrome Web Store से इंस्टॉल करें। यह Chrome, Arc, Brave, Edge, Vivaldi और किसी भी Chromium ब्राउज़र में काम करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang ekstensi dari Chrome Web Store. Ekstensi ini berjalan di Chrome, Arc, Brave, Edge, Vivaldi, dan browser Chromium apa pun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài tiện ích từ Chrome Web Store. Tiện ích chạy trên Chrome, Arc, Brave, Edge, Vivaldi và mọi trình duyệt Chromium."
          }
        }
      }
    },
