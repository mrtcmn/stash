    "Shortcuts work everywhere. Click one, then press the new keys; Delete removes it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетания работают везде. Нажми на одно, затем нажми новые клавиши. Delete удаляет его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скорочення працюють усюди. Натисни одне, потім натисни нові клавіші. Delete видаляє його."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skróty działają wszędzie. Kliknij jeden i naciśnij nowe klawisze. Delete go usuwa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toetscombinaties werken overal. Klik op een combinatie en druk op de nieuwe toetsen. Delete verwijdert hem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler her yerde çalışır. Birine tıkla, sonra yeni tuşlara bas. Delete onu kaldırır."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos funcionan en todas partes. Haz clic en uno y pulsa las teclas nuevas; la tecla Eliminar lo quita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos funcionam em qualquer lugar. Clique em um e pressione as novas teclas; a tecla Apagar remove o atalho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis fonctionnent partout. Clique sur l’un d’eux, puis appuie sur les nouvelles touches ; Supprimer l’efface."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le abbreviazioni funzionano ovunque. Fai clic su una, poi premi i nuovi tasti; il tasto Cancella la rimuove."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzbefehle funktionieren überall. Klicke auf einen und drücke dann die neuen Tasten; die Löschtaste entfernt ihn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键在任何地方都有效。点按一个快捷键，然后按下新按键；按 Delete 键可将其移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速鍵在任何地方都能用。按一下其中一個，然後按下新的按鍵；按 Delete 鍵即可移除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットはどこでも使えます。クリックしてから新しいキーを押してください。Delete キーで削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키는 어디서나 작동합니다. 하나를 클릭한 다음 새 키를 누르세요. Delete 키를 누르면 제거됩니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำสั่งลัดใช้ได้ทุกที่ คลิกที่คำสั่งลัด แล้วกดปุ่มใหม่ ปุ่ม Delete จะเอาคำสั่งลัดออก"
