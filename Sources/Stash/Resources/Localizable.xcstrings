    "Search by image — or drop one here": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск по изображению — или перетащи его сюда"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошук за зображенням — або перетягни його сюди"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szukaj obrazem — albo upuść go tutaj"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek met een afbeelding — of zet er hier een neer"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görselle ara — ya da buraya bir görsel bırak"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca por imagen o suelta una aquí"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque por imagem — ou solte uma aqui"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche par image — ou dépose-en une ici"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca per immagine — o trascinane una qui"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Bild suchen — oder hier eins ablegen"
          }
        },
        "zh-Hans": {
