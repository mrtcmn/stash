    "Keep copies of post images for offline use": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاحتفاظ بنسخ من صور المنشورات للاستخدام دون اتصال"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopien von Post-Bildern für die Offline-Nutzung behalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar copias de las imágenes de los posts para usarlas sin conexión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder une copie des images des posts pour un usage hors ligne"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफ़लाइन इस्तेमाल के लिए पोस्ट की इमेज की कॉपी रखें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan salinan gambar postingan untuk dipakai offline"
          }
        },
        "it": {
          "stringUnit": {
