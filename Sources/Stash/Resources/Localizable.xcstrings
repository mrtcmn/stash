            "state": "translated",
            "value": "画像で検索 — またはここにドロップ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지로 검색 — 또는 여기에 드롭"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek met een afbeelding — of zet er hier een neer"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szukaj obrazem — albo upuść go tutaj"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque por imagem — ou solte uma aqui"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск по изображению — или перетащи его сюда"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหาด้วยรูปภาพ — หรือลากมาวางที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görselle ara — ya da buraya bir görsel bırak"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошук за зображенням — або перетягни його сюди"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm bằng hình ảnh — hoặc thả ảnh vào đây"
          }
        },
        "zh-Hans": {
