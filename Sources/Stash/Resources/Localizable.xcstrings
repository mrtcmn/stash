          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एम्बेडिंग रनटाइम शुरू नहीं हुआ। पहले डाउनलोड के लिए अपना इंटरनेट कनेक्शन जाँचें।"
          }
        },
