          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere app gebruikt deze toetscombinatie al."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inna aplikacja używa już tego skrótu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro app já usa este atalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это сочетание уже занято другим приложением."
          }
