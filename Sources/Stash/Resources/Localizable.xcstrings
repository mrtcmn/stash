    "Change it in the extension's popup too.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измени его и во всплывающем окне расширения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни його і у спливному вікні розширення."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmień go też w okienku rozszerzenia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzig het ook in de pop-up van de extensie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu uzantının açılır penceresinde de değiştir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cámbialo también en la ventana emergente de la extensión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere também no pop-up da extensão."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Change-le aussi dans la fenêtre de l’extension."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiala anche nel popup dell’estensione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere ihn auch im Pop-up der Erweiterung."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也请在扩展程序的弹出窗口中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "也請在擴充功能的彈出視窗中更改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張機能のポップアップでも変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확장 프로그램 팝업에서도 변경하세요."
