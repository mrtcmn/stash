            "value": "لم تبدأ بيئة تشغيل التضمين. تحقق من اتصالك بالإنترنت للتنزيل الأول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Embedding-Laufzeit ist nicht gestartet. Prüfe deine Internetverbindung für den ersten Download."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entorno de embeddings no se inició. Revisa tu conexión a internet para la primera descarga."
          }
        },
        "fr": {
          "stringUnit": {
