    "Bring a browser window to the front first.": {
      "comment": "HUD error when the user snips a browser tab",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجلب نافذة متصفح إلى المقدمة أولًا."
