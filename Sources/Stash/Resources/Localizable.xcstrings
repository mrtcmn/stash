    "%@ has no open window.": {
      "comment": "HUD error when the user snips a browser tab; the argument is the browser name",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В %@ нет открытого окна."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У %@ немає відкритого вікна."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie ma otwartego okna."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft geen open venster."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uygulamasında açık pencere yok."
          }
        },
        "es": {
