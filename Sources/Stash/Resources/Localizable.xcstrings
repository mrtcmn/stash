            "value": "Conserva copie delle immagini dei post per l’uso offline"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインで使えるようにポストの画像のコピーを保存"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인에서 사용할 수 있도록 게시물 이미지 사본 보관"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar kopieën van post-afbeeldingen voor offline gebruik"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechowuj kopie obrazów z postów do użytku offline"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
