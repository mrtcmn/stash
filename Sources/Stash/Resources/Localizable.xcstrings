    "Choose an X archive (.zip or folder), a JSON or CSV export, browser bookmarks (.html), Markdown or images.": {
      "comment": "Import open panel message",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر أرشيف X (‏.zip أو مجلد)، أو ملف تصدير JSON أو CSV، أو إشارات المتصفح المرجعية (‏.html)، أو Markdown أو صورًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein X-Archiv (.zip oder Ordner), einen JSON- oder CSV-Export, Browser-Lesezeichen (.html), Markdown oder Bilder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un archivo de X (.zip o carpeta), una exportación JSON o CSV, marcadores del navegador (.html), Markdown o imágenes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis une archive X (.zip ou dossier), un export JSON ou CSV, des signets de navigateur (.html), du Markdown ou des images."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "X आर्काइव (.zip या फ़ोल्डर), JSON या CSV एक्सपोर्ट, ब्राउज़र बुकमार्क (.html), Markdown या इमेज चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih arsip X (.zip atau folder), ekspor JSON atau CSV, bookmark browser (.html), Markdown, atau gambar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un archivio di X (.zip o cartella), un’esportazione JSON o CSV, i segnalibri del browser (.html), Markdown o immagini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "X のアーカイブ（.zip またはフォルダ）、JSON / CSV のエクスポート、ブラウザのブックマーク（.html）、Markdown、または画像を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "X 아카이브(.zip 또는 폴더), JSON 또는 CSV 내보내기 파일, 브라우저 북마크(.html), Markdown 또는 이미지를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een X-archief (.zip of map), een JSON- of CSV-export, browserbladwijzers (.html), Markdown of afbeeldingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz archiwum X (.zip lub folder), eksport JSON lub CSV, zakładki przeglądarki (.html), Markdown lub obrazy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um arquivo do X (.zip ou pasta), uma exportação JSON ou CSV, marcadores do navegador (.html), Markdown ou imagens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери архив X (.zip или папку), экспорт JSON или CSV, закладки браузера (.html), Markdown или изображения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกไฟล์เก็บถาวร X (.zip หรือโฟลเดอร์) ไฟล์ส่งออก JSON หรือ CSV บุ๊กมาร์กเบราว์เซอร์ (.html) Markdown หรือรูปภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir X arşivi (.zip veya klasör), JSON ya da CSV dışa aktarımı, tarayıcı yer işaretleri (.html), Markdown veya görseller seç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибери архів X (.zip або папку), експорт JSON чи CSV, закладки браузера (.html), Markdown або зображення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn bản lưu trữ X (.zip hoặc thư mục), tệp xuất JSON hoặc CSV, dấu trang trình duyệt (.html), Markdown hoặc hình ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 X 存档（.zip 或文件夹）、JSON 或 CSV 导出文件、浏览器书签 (.html)、Markdown 或图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 X 封存檔（.zip 或資料夾）、JSON 或 CSV 匯出檔、瀏覽器書籤 (.html)、Markdown 或圖片。"
          }
        }
      }
    },
