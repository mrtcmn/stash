    "Change it in the extension's popup too.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّره في النافذة المنبثقة للإضافة أيضًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere ihn auch im Pop-up der Erweiterung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cámbialo también en la ventana emergente de la extensión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Change-le aussi dans la fenêtre de l’extension."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे एक्सटेंशन के पॉपअप में भी बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah juga di popup ekstensi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiala anche nel popup dell’estensione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張機能のポップアップでも変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확장 프로그램 팝업에서도 변경하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzig het ook in de pop-up van de extensie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmień go też w okienku rozszerzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere também no pop-up da extensão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измени его и во всплывающем окне расширения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนในป๊อปอัปของส่วนขยายด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu uzantının açılır penceresinde de değiştir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни його і у спливному вікні розширення."
          }
        },
        "vi": {
