    "Needed for area, window and text (OCR) captures. Press ⌃⇧4 any time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب لالتقاط المنطقة والنافذة والنص (OCR). اضغط ⌃⇧4 في أي وقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nötig für Bereichs-, Fenster- und Textaufnahmen (OCR). Drücke jederzeit ⌃⇧4."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesario para capturas de área, ventana y texto (OCR). Pulsa ⌃⇧4 cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour les captures de zone, de fenêtre et de texte (OCR). Appuie sur ⌃⇧4 à tout moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हिस्से, विंडो और टेक्स्ट (OCR) कैप्चर के लिए ज़रूरी। कभी भी ⌃⇧4 दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperlukan untuk menangkap area, jendela, dan teks (OCR). Tekan ⌃⇧4 kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessaria per le catture di area, finestra e testo (OCR). Premi ⌃⇧4 in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エリア、ウインドウ、テキスト（OCR）のキャプチャに必要です。⌃⇧4 でいつでもキャプチャできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역, 윈도우, 텍스트(OCR) 캡처에 필요합니다. 언제든 ⌃⇧4를 누르세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodig om een gebied, venster of tekst (OCR) vast te leggen. Druk op ⌃⇧4 wanneer je wilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzebne do zrzutów obszaru, okna i tekstu (OCR). Naciśnij ⌃⇧4 w dowolnej chwili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessário para capturas de área, janela e texto (OCR). Pressione ⌃⇧4 quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно для снимков области, окна и текста (OCR). Нажми ⌃⇧4 в любой момент."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำเป็นสำหรับการจับภาพพื้นที่ หน้าต่าง และข้อความ (OCR) กด ⌃⇧4 ได้ทุกเมื่อ"
          }
        },
        "tr": {
