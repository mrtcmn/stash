    "They will be downloaded again the next time semantic search starts.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم تنزيلها مجددًا في المرة القادمة التي يبدأ فيها البحث الدلالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie werden beim nächsten Start der semantischen Suche erneut geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se volverán a descargar la próxima vez que se inicie la búsqueda semántica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils seront de nouveau téléchargés au prochain démarrage de la recherche sémantique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगली बार सिमैंटिक सर्च शुरू होने पर ये फिर से डाउनलोड होंगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File ini akan diunduh lagi saat pencarian semantik dimulai berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno scaricati di nuovo al prossimo avvio della ricerca semantica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次にセマンティック検索を開始するときに、もう一度ダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에 의미 검색을 시작할 때 다시 다운로드됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze worden opnieuw gedownload als semantisch zoeken de volgende keer start."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaną pobrane ponownie przy następnym uruchomieniu wyszukiwania semantycznego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles serão baixados de novo na próxima vez que a busca semântica iniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они загрузятся снова при следующем запуске семантического поиска."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์จะถูกดาวน์โหลดอีกครั้งเมื่อเริ่มการค้นหาเชิงความหมายครั้งถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anlamsal arama bir sonraki başladığında yeniden indirilecekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Їх буде завантажено знову під час наступного запуску семантичного пошуку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tệp sẽ được tải lại vào lần tới tìm kiếm ngữ nghĩa khởi động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次启动语义搜索时会重新下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下次啟動語意搜尋時會重新下載。"
          }
        }
      }
    },
    "This search engine can't read images.": {
