    "%@ has no open window.": {
      "comment": "HUD error when the user snips a browser tab; the argument is the browser name",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد نافذة مفتوحة في %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat kein offenes Fenster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene ninguna ventana abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a aucune fenêtre ouverte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ में कोई विंडो खुली नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak punya jendela yang terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha finestre aperte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に開いているウインドウがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 열린 윈도우가 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft geen open venster."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie ma otwartego okna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não tem nenhuma janela aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В %@ нет открытого окна."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่มีหน้าต่างที่เปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uygulamasında açık pencere yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У %@ немає відкритого вікна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không có cửa sổ nào đang mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有打开的窗口。"
          }
        },
        "zh-Hant": {
