    "Snip posts from X with the browser extension, capture your screen with ⌃⇧4, or import your X bookmarks.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقتطع منشورات X باستخدام إضافة المتصفح، أو التقط شاشتك بـ ⌃⇧4، أو استورد إشارات X المرجعية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere Posts von X mit der Browser-Erweiterung, nimm deinen Bildschirm mit ⌃⇧4 auf oder importiere deine X-Lesezeichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda posts de X con la extensión del navegador, captura tu pantalla con ⌃⇧4 o importa tus marcadores de X."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre des posts X avec l’extension de navigateur, capture ton écran avec ⌃⇧4 ou importe tes signets X."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्राउज़र एक्सटेंशन से X की पोस्ट स्निप करें, ⌃⇧4 से अपनी स्क्रीन कैप्चर करें, या अपने X बुकमार्क इंपोर्ट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip postingan dari X dengan ekstensi browser, tangkap layar dengan ⌃⇧4, atau impor bookmark X-mu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva i post di X con l’estensione per il browser, cattura lo schermo con ⌃⇧4 o importa i tuoi segnalibri di X."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザ拡張機能で X のポストをスニップしたり、⌃⇧4 で画面をキャプチャしたり、X のブックマークをインポートしたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 확장 프로그램으로 X 게시물을 저장하거나, ⌃⇧4로 화면을 캡처하거나, X 북마크를 가져오세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar posts van X met de browserextensie, leg je scherm vast met ⌃⇧4 of importeer je X-bladwijzers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuj posty z X rozszerzeniem przeglądarki, przechwytuj ekran skrótem ⌃⇧4 albo zaimportuj zakładki X."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve posts do X com a extensão do navegador, capture a tela com ⌃⇧4 ou importe seus marcadores do X."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняй посты из X через расширение для браузера, делай снимки экрана с ⌃⇧4 или импортируй закладки X."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บโพสต์จาก X ด้วยส่วนขยายเบราว์เซอร์ จับภาพหน้าจอด้วย ⌃⇧4 หรือนำเข้าบุ๊กมาร์ก X ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "X gönderilerini tarayıcı uzantısıyla kaydet, ekranını ⌃⇧4 ile yakala ya da X yer işaretlerini içe aktar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігай пости з X через розширення для браузера, роби знімки екрана з ⌃⇧4 або імпортуй закладки X."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu bài đăng từ X bằng tiện ích trình duyệt, chụp màn hình bằng ⌃⇧4, hoặc nhập dấu trang X của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用浏览器扩展程序摘录 X 帖子，按 ⌃⇧4 截取屏幕，或导入你的 X 书签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用瀏覽器擴充功能摘錄 X 貼文、按 ⌃⇧4 擷取螢幕，或匯入你的 X 書籤。"
          }
        }
      }
    },
