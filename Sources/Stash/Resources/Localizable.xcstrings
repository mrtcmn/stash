    "Search by image — or drop one here": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث بصورة — أو أفلت صورة هنا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Bild suchen — oder hier eins ablegen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca por imagen o suelta una aquí"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche par image — ou dépose-en une ici"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इमेज से खोजें — या यहाँ कोई इमेज छोड़ें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari dengan gambar — atau lepas gambar di sini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca per immagine — o trascinane una qui"
          }
        },
        "ja": {
