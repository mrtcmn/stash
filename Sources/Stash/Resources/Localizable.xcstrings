        }
      }
    },
    "Search by meaning — “charts about growth”, “funny cats”…": {
      "comment": "Search field placeholder when semantic search is ready",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث بالمعنى — «رسوم بيانية عن النمو»، «قطط مضحكة»…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Bedeutung suchen — „Diagramme zu Wachstum“, „lustige Katzen“ …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca por significado: “gráficos de crecimiento”, “gatos graciosos”…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche par le sens — « graphiques sur la croissance », « chats drôles »…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अर्थ से खोजें — “ग्रोथ के चार्ट”, “मज़ेदार बिल्लियाँ”…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari berdasarkan makna — “grafik pertumbuhan”, “kucing lucu”…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca per significato — “grafici sulla crescita”, “gatti buffi”…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "意味で検索 — 「成長に関するグラフ」「おもしろい猫」…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의미로 검색 — “성장에 관한 차트”, “웃긴 고양이”…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek op betekenis — ‘grafieken over groei’, ‘grappige katten’…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szukaj po znaczeniu — „wykresy o wzroście”, „śmieszne koty”…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque por significado — “gráficos sobre crescimento”, “gatos engraçados”…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск по смыслу — «графики о росте», «смешные коты»…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหาด้วยความหมาย — “กราฟเรื่องการเติบโต”, “แมวตลกๆ”…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anlama göre ara — “büyüme grafikleri”, “komik kediler”…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошук за змістом — «графіки про зростання», «смішні коти»…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm theo ý nghĩa — “biểu đồ tăng trưởng”, “mèo hài hước”…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按含义搜索 — “关于增长的图表”“搞笑的猫”…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依意義搜尋 — 「關於成長的圖表」「好笑的貓」…"
          }
        }
      }
    },
