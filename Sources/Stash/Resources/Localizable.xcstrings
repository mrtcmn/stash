        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّره في النافذة المنبثقة للإضافة أيضًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे एक्सटेंशन के पॉपअप में भी बदलें।"
          }
        },
        "id": {
