          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임베딩 런타임이 시작되지 않았습니다. 최초 다운로드를 위해 인터넷 연결을 확인하세요."
          }
        },
        "nl": {
