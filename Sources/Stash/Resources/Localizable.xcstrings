    "Install it from the Chrome Web Store in Chrome, Arc, Brave or Edge. You get a Snip button on every post and one-click bookmark import.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّتها من Chrome Web Store في Chrome أو Arc أو Brave أو Edge. ستحصل على زر اقتطاع في كل منشور واستيراد للإشارات المرجعية بنقرة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere sie aus dem Chrome Web Store in Chrome, Arc, Brave oder Edge. Du bekommst einen Snip-Button an jedem Post und den Lesezeichen-Import mit einem Klick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instálala desde la Chrome Web Store en Chrome, Arc, Brave o Edge. Tendrás un botón para guardar en cada post y la importación de marcadores con un clic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe-la depuis le Chrome Web Store dans Chrome, Arc, Brave ou Edge. Tu obtiens un bouton d’enregistrement sur chaque post et l’import des signets en un clic."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे Chrome, Arc, Brave या Edge में Chrome Web Store से इंस्टॉल करें। आपको हर पोस्ट पर एक स्निप बटन और एक क्लिक में बुकमार्क इंपोर्ट मिलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang dari Chrome Web Store di Chrome, Arc, Brave, atau Edge. Kamu mendapat tombol Snip di setiap postingan dan impor bookmark sekali klik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installala dal Chrome Web Store in Chrome, Arc, Brave o Edge. Avrai un pulsante per salvare su ogni post e l’importazione dei segnalibri con un clic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome、Arc、Brave、Edge で Chrome ウェブストアからインストールしてください。すべてのポストに保存ボタンが付き、ブックマークをワンクリックでインポートできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome, Arc, Brave 또는 Edge에서 Chrome 웹 스토어를 통해 설치하세요. 모든 게시물에 저장 버튼이 생기고, 클릭 한 번으로 북마크를 가져올 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer hem via de Chrome Web Store in Chrome, Arc, Brave of Edge. Je krijgt een bewaarknop bij elke post en importeert bladwijzers met één klik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstaluj je z Chrome Web Store w Chrome, Arc, Brave lub Edge. Dostaniesz przycisk zapisu przy każdym poście i import zakładek jednym kliknięciem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale pela Chrome Web Store no Chrome, Arc, Brave ou Edge. Você ganha um botão para salvar em cada post e importação de marcadores com um clique."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установи его из Chrome Web Store в Chrome, Arc, Brave или Edge. На каждом посте появится кнопка сохранения, а закладки можно импортировать в один клик."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้งจาก Chrome เว็บสโตร์ใน Chrome, Arc, Brave หรือ Edge คุณจะได้ปุ่มบันทึกบนทุกโพสต์ และนำเข้าบุ๊กมาร์กได้ในคลิกเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome, Arc, Brave veya Edge'de Chrome Web Store'dan yükle. Her gönderide bir kaydet düğmesi ve tek tıkla yer işareti aktarma kazanırsın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встанови його з Chrome Web Store у Chrome, Arc, Brave або Edge. На кожному пості з’явиться кнопка збереження, а закладки можна імпортувати в один клік."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài từ Chrome Web Store trong Chrome, Arc, Brave hoặc Edge. Bạn có nút Snip trên mọi bài đăng và nhập dấu trang chỉ với một cú nhấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Chrome、Arc、Brave 或 Edge 中从 Chrome 应用商店安装。每条帖子上都会出现保存按钮，还能一键导入书签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Chrome、Arc、Brave 或 Edge 中從 Chrome 線上應用程式商店安裝。每則貼文上都會出現儲存按鈕，還能一鍵匯入書籤。"
          }
        }
      }
    },
    "Install the Stash browser extension to import bookmarks": {
      "comment": "HUD when the user imports X bookmarks without the extension",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت إضافة Stash للمتصفح لاستيراد الإشارات المرجعية"
          }
        },
        "de": {
