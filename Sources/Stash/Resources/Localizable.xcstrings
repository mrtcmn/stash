            "state": "translated",
            "value": "%@ no tiene ninguna ventana abierta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não tem nenhuma janela aberta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a aucune fenêtre ouverte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha finestre aperte."
          }
        },
