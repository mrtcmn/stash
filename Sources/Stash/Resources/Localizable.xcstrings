          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale a extensão do Stash para importar marcadores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe l’extension de navigateur Stash pour importer des signets"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa l’estensione di Stash per importare i segnalibri"
          }
        },
        "de": {
          "stringUnit": {
