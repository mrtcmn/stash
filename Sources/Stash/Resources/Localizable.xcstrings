    "Screen Recording is allowed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الشاشة مسموح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmaufnahme ist erlaubt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación de pantalla está permitida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement de l’écran est autorisé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन रिकॉर्डिंग की अनुमति है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perekaman Layar diizinkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione schermo è consentita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録は許可されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 기록이 허용되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schermopname is toegestaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie ekranu jest dozwolone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Gravação de Tela está permitida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись экрана разрешена."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการบันทึกหน้าจอแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran Kaydı'na izin verildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис екрана дозволено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã cho phép ghi màn hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许录屏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已允許螢幕錄製。"
          }
        }
      }
    },
    "Screen Recording is needed for screenshots.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الشاشة مطلوب للقطات الشاشة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Screenshots ist die Bildschirmaufnahme nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas de pantalla necesitan la grabación de pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement de l’écran est nécessaire pour les captures d’écran."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीनशॉट के लिए स्क्रीन रिकॉर्डिंग ज़रूरी है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perekaman Layar diperlukan untuk tangkapan layar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione schermo serve per gli screenshot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットには画面収録が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린샷을 찍으려면 화면 기록이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schermopname is nodig voor screenshots."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrzuty ekranu wymagają nagrywania ekranu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Gravação de Tela é necessária para capturas de tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для скриншотов нужна запись экрана."
          }
        },
