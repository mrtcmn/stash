    "WebGPU isn't available, which EmbeddingGemma 2 needs. Using Apple's built-in embeddings instead.": {
      "comment": "Search settings notice when the app falls back to Apple embeddings",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "WebGPU недоступен, а он нужен EmbeddingGemma 2. Вместо этого используются встроенные эмбеддинги Apple."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "WebGPU недоступний, а він потрібен EmbeddingGemma 2. Натомість використовуються вбудовані ембедінги Apple."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "WebGPU jest niedostępne, a EmbeddingGemma 2 go wymaga. Zamiast tego używane są wbudowane embeddingi Apple."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "WebGPU is niet beschikbaar, en dat heeft EmbeddingGemma 2 nodig. In plaats daarvan worden de ingebouwde embeddings van Apple gebruikt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "EmbeddingGemma 2'nin ihtiyaç duyduğu WebGPU kullanılamıyor. Bunun yerine Apple'ın yerleşik embedding'leri kullanılıyor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "WebGPU no está disponible y EmbeddingGemma 2 lo necesita. Se usan los embeddings integrados de Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O WebGPU não está disponível, e o EmbeddingGemma 2 precisa dele. Usando os embeddings integrados da Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "WebGPU n’est pas disponible, alors qu’EmbeddingGemma 2 en a besoin. Stash utilise les embeddings intégrés d’Apple à la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "WebGPU non è disponibile ed EmbeddingGemma 2 ne ha bisogno. Uso gli embedding integrati di Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WebGPU ist nicht verfügbar, wird aber für EmbeddingGemma 2 gebraucht. Stash nutzt stattdessen die integrierten Embeddings von Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "EmbeddingGemma 2 需要 WebGPU，但当前不可用。将改用 Apple 的内置嵌入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "EmbeddingGemma 2 需要 WebGPU，但目前無法使用。將改用 Apple 的內建嵌入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "EmbeddingGemma 2 に必要な WebGPU を使用できません。代わりに Apple の内蔵埋め込みを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "EmbeddingGemma 2에 필요한 WebGPU를 사용할 수 없습니다. 대신 Apple 내장 임베딩을 사용합니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มี WebGPU ซึ่ง EmbeddingGemma 2 ต้องใช้ จึงใช้เอ็มเบดดิงในตัวของ Apple แทน"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "WebGPU غير متاح، ويحتاجه EmbeddingGemma 2. يستخدم Stash تضمينات Apple المدمجة بدلًا منه."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "WebGPU उपलब्ध नहीं है, जिसकी EmbeddingGemma 2 को ज़रूरत है। इसकी जगह Apple की बिल्ट-इन एम्बेडिंग इस्तेमाल हो रही हैं।"
          }
        },
        "id": {
          "stringUnit": {
