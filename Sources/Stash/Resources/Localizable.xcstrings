    "Stash couldn't open its library file, so changes won't be saved this session.": {
      "comment": "HUD error at launch when the database cannot open",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Stash فتح ملف مكتبته، لذا لن تُحفظ التغييرات في هذه الجلسة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash konnte seine Mediathek-Datei nicht öffnen, daher werden Änderungen in dieser Sitzung nicht gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash no pudo abrir el archivo de su biblioteca, así que los cambios no se guardarán en esta sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash n’a pas pu ouvrir son fichier de bibliothèque, donc les modifications ne seront pas enregistrées pendant cette session."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash अपनी लाइब्रेरी फ़ाइल नहीं खोल सका, इसलिए इस सेशन में बदलाव सहेजे नहीं जाएँगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash tidak bisa membuka file pustakanya, jadi perubahan tidak akan disimpan di sesi ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash non è riuscito ad aprire il file della libreria, quindi le modifiche non verranno salvate in questa sessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash はライブラリファイルを開けなかったため、このセッションの変更は保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash가 보관함 파일을 열 수 없어 이번 세션의 변경 사항은 저장되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash kon het bibliotheekbestand niet openen, dus wijzigingen worden deze sessie niet bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash nie może otworzyć pliku biblioteki, więc zmiany w tej sesji nie zostaną zapisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Stash não conseguiu abrir o arquivo da biblioteca, então as alterações não serão salvas nesta sessão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash не удалось открыть файл библиотеки, поэтому изменения в этом сеансе не сохранятся."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash เปิดไฟล์คลังไม่ได้ การเปลี่ยนแปลงในเซสชันนี้จึงจะไม่ถูกบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash arşiv dosyasını açamadı, bu yüzden bu oturumdaki değişiklikler kaydedilmeyecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash не вдалося відкрити файл бібліотеки, тому зміни в цьому сеансі не збережуться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash không mở được tệp thư viện, nên các thay đổi trong phiên này sẽ không được lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash 无法打开资料库文件，因此本次会话中的更改不会被保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash 無法打開資料庫檔案，因此本次工作階段中的變更不會被儲存。"
          }
        }
      }
    },
    "Stash is shutting down": {
      "comment": "Error the local server sends to the browser extension",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم إيقاف Stash"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash wird beendet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash se está cerrando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash est en cours de fermeture"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash बंद हो रहा है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash sedang dimatikan"
          }
        },
        "it": {
