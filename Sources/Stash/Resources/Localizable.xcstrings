    "Works with Claude Code, Codex, Cursor and any client that speaks MCP over HTTP. The server only answers this Mac, and only while Stash is open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل مع Claude Code وCodex وCursor وأي عميل يستخدم MCP عبر HTTP. يرد الخادم على هذا الـMac فقط، وفقط أثناء فتح Stash."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert mit Claude Code, Codex, Cursor und jedem Client, der MCP über HTTP spricht. Der Server antwortet nur diesem Mac und nur, solange Stash geöffnet ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona con Claude Code, Codex, Cursor y cualquier cliente que use MCP por HTTP. El servidor solo responde a este Mac y solo mientras Stash está abierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne avec Claude Code, Codex, Cursor et tout client qui parle MCP via HTTP. Le serveur ne répond qu’à ce Mac, et seulement quand Stash est ouvert."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex, Cursor और HTTP पर MCP इस्तेमाल करने वाले किसी भी क्लाइंट के साथ काम करता है। सर्वर सिर्फ़ इस Mac को जवाब देता है, और सिर्फ़ तब जब Stash खुला हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekerja dengan Claude Code, Codex, Cursor, dan klien apa pun yang memakai MCP lewat HTTP. Server hanya menjawab Mac ini, dan hanya saat Stash terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona con Claude Code, Codex, Cursor e qualsiasi client che usa MCP via HTTP. Il server risponde solo a questo Mac e solo mentre Stash è aperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code、Codex、Cursor など、HTTP で MCP を使うすべてのクライアントで使えます。サーバはこのMacにのみ応答し、Stash が開いている間だけ動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex, Cursor 및 HTTP로 MCP를 사용하는 모든 클라이언트와 함께 작동합니다. 서버는 이 Mac에만 응답하며 Stash가 열려 있을 때만 작동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkt met Claude Code, Codex, Cursor en elke client die MCP via HTTP spreekt. De server antwoordt alleen deze Mac, en alleen zolang Stash open is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa z Claude Code, Codex, Cursor i każdym klientem, który używa MCP przez HTTP. Serwer odpowiada tylko temu Macowi i tylko gdy Stash jest otwarty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona com Claude Code, Codex, Cursor e qualquer cliente que use MCP via HTTP. O servidor só responde a este Mac e só enquanto o Stash está aberto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает с Claude Code, Codex, Cursor и любым клиентом, который использует MCP по HTTP. Сервер отвечает только этому Mac и только пока Stash открыт."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ได้กับ Claude Code, Codex, Cursor และไคลเอนต์ใดก็ได้ที่ใช้ MCP ผ่าน HTTP เซิร์ฟเวอร์ตอบเฉพาะ Mac เครื่องนี้ และเฉพาะตอนที่ Stash เปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex, Cursor ve MCP'yi HTTP üzerinden kullanan her istemciyle çalışır. Sunucu yalnızca bu Mac'e ve yalnızca Stash açıkken yanıt verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Працює з Claude Code, Codex, Cursor і будь-яким клієнтом, що використовує MCP через HTTP. Сервер відповідає лише цьому Mac і лише поки Stash відкрито."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoạt động với Claude Code, Codex, Cursor và mọi ứng dụng dùng MCP qua HTTP. Máy chủ chỉ trả lời máy Mac này, và chỉ khi Stash đang mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 Claude Code、Codex、Cursor 以及任何通过 HTTP 使用 MCP 的客户端。服务器只响应这台 Mac，且仅在 Stash 打开时运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援 Claude Code、Codex、Cursor 以及任何透過 HTTP 使用 MCP 的用戶端。伺服器只回應這台 Mac，且僅在 Stash 開啟時運作。"
          }
        }
      }
    },
    "Write something worth finding later…": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب شيئًا يستحق العثور عليه لاحقًا…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib etwas, das du später wiederfinden willst …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe algo que valga la pena encontrar más tarde…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris quelque chose qui vaut la peine d’être retrouvé…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ ऐसा लिखें जो बाद में ढूँढने लायक हो…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis sesuatu yang layak ditemukan nanti…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi qualcosa che valga la pena ritrovare…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとで見つけたくなることを書きましょう…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 찾고 싶은 것을 적어 보세요…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf iets wat je later wilt terugvinden…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisz coś, co warto później znaleźć…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva algo que valha a pena encontrar depois…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напиши то, что стоит найти потом…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขียนสิ่งที่อยากหาเจอในภายหลัง…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonra bulmaya değer bir şey yaz…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Напиши те, що варто знайти потім…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viết điều gì đó đáng để tìm lại sau…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写下以后值得找回的内容…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫下以後值得找回的內容…"
          }
        }
      }
    },
