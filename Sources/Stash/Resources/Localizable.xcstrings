    "Name a topic. Stash finds the snips that are about it, also by what their images show.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب موضوعًا. يجد Stash القصاصات المتعلقة به، حتى من محتوى صورها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenne ein Thema. Stash findet die Snips dazu, auch anhand dessen, was ihre Bilder zeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un tema. Stash encuentra los recortes sobre él, también por lo que muestran sus imágenes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomme un sujet. Stash trouve les extraits qui en parlent, aussi d’après leurs images."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई विषय लिखें। Stash उससे जुड़े स्निप ढूँढता है, उनकी इमेज में दिखी चीज़ों से भी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis sebuah topik. Stash menemukan snip tentang topik itu, juga dari isi gambarnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi un argomento. Stash trova i ritagli che ne parlano, anche da ciò che mostrano le immagini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トピックを入力してください。Stash がそれに関するスニップを、画像の内容からも見つけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주제를 입력하세요. Stash가 관련 항목을 찾고, 이미지 내용으로도 찾습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef een onderwerp op. Stash vindt de snips erover, ook op basis van wat de afbeeldingen tonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwij temat. Stash znajdzie zapisy na ten temat, także po tym, co pokazują obrazy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê nome a um tema. O Stash encontra os recortes sobre ele, também pelo que as imagens mostram."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назови тему. Stash найдёт записи о ней, в том числе по содержимому изображений."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งชื่อหัวข้อ Stash จะหารายการที่เกี่ยวข้อง รวมถึงจากสิ่งที่อยู่ในรูปภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir konu yaz. Stash onunla ilgili kayıtları, görsellerde ne olduğuna bakarak da bulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назви тему. Stash знайде записи про неї, зокрема за вмістом зображень."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt tên một chủ đề. Stash tìm các mẩu lưu về chủ đề đó, kể cả theo nội dung hình ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入一个主题。Stash 会找出与之相关的摘录，也会根据图片内容查找。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入一個主題。Stash 會找出與之相關的摘錄，也會依圖片內容尋找。"
          }
        }
      }
    },
