{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Stash",
  "version": "1.3.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Stash",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "bookmarks"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://mobile.x.com/*",
    "https://mobile.twitter.com/*",
    "https://www.reddit.com/*",
    "https://old.reddit.com/*",
    "https://*.pinterest.com/*",
    "https://*.pinterest.co.uk/*",
    "https://*.pinterest.ca/*",
    "https://*.pinterest.com.au/*",
    "https://*.pinterest.de/*",
    "https://*.pinterest.fr/*",
    "https://*.pinterest.es/*",
    "https://*.pinterest.it/*",
    "https://*.pinterest.jp/*",
    "https://*.pinterest.com.mx/*",
    "https://*.pinterest.pt/*",
    "https://*.pinterest.nz/*",
    "https://*.pinterest.ie/*",
    "https://*.pinterest.at/*",
    "https://*.pinterest.ch/*",
    "https://*.pinterest.se/*",
    "https://*.pinterest.dk/*",
    "https://*.pinterest.cl/*",
    "https://*.pinterest.ph/*",
    "http://127.0.0.1/*"
  ],
  "commands": {
    "save-page": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "__MSG_cmdSavePage__"
    },
    "screenshot-tab": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "__MSG_cmdScreenshot__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.x.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": [
        "shared/tweet-parse.js",
        "content/x-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.x.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": [
        "content/x.js"
      ],
      "css": [
        "content/x.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.reddit.com/*",
        "https://old.reddit.com/*"
      ],
      "js": [
        "shared/reddit-parse.js",
        "content/sites.js",
        "content/reddit.js"
      ],
      "css": [
        "content/x.css",
        "content/sites.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.pinterest.com/*",
        "https://*.pinterest.co.uk/*",
        "https://*.pinterest.ca/*",
        "https://*.pinterest.com.au/*",
        "https://*.pinterest.de/*",
        "https://*.pinterest.fr/*",
        "https://*.pinterest.es/*",
        "https://*.pinterest.it/*",
        "https://*.pinterest.jp/*",
        "https://*.pinterest.com.mx/*",
        "https://*.pinterest.pt/*",
        "https://*.pinterest.nz/*",
        "https://*.pinterest.ie/*",
        "https://*.pinterest.at/*",
        "https://*.pinterest.ch/*",
        "https://*.pinterest.se/*",
        "https://*.pinterest.dk/*",
        "https://*.pinterest.cl/*",
        "https://*.pinterest.ph/*"
      ],
      "js": [
        "shared/pinterest-parse.js",
        "content/sites.js",
        "content/pinterest.js"
      ],
      "css": [
        "content/x.css",
        "content/sites.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
