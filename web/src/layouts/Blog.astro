---
// Blog shell: the homepage's sky band, header and footer, with no client JS.
import Base from './Base.astro'
import { FooterWordmark } from '../components/FooterWordmark'
const props = Astro.props
---
<Base {...props}>
  <slot name="head" slot="head" />
  <div class="flex min-h-full w-full flex-col items-center overflow-x-clip bg-[#FBFBFA] text-[#0A0A0A]">
    <div class="relative -mb-px w-full overflow-hidden text-white">
      <div class="absolute inset-0 bg-[linear-gradient(180deg,#1f57c9_0%,#2d6ce0_40%,#4f8ae9_75%,#8cb8f3_100%)]" aria-hidden="true"></div>
      <header class="relative flex w-full justify-center border-b border-white/15">
        <div class="flex h-16 w-full max-w-[1120px] items-center justify-between border-x border-white/15 px-6">
          <a href="/" aria-label="Stash"><img src="/wordmark.webp" alt="Stash" width="83" height="22" class="h-[22px] w-auto" /></a>
          <nav class="flex items-center gap-8 text-[14px] text-white/80">
            <a href="/blog/">Blog</a>
            <a href="/rss.xml">RSS</a>
            <a href="/" class="inline-flex h-9 items-center rounded-full bg-white px-4 font-medium text-[#0A0A0A]">Download</a>
          </nav>
        </div>
      </header>
      <div class="relative mx-auto w-full max-w-[1120px] border-x border-white/15 px-6 pb-14 pt-16 md:px-10">
        <slot name="hero" />
      </div>
    </div>
    <main class="w-full max-w-[1120px] flex-1 border-x border-[#E8E8E5] px-6 py-12 md:px-10">
      <slot />
    </main>
    <footer class="flex w-full justify-center border-t border-[#E8E8E5]">
      <div class="relative w-full max-w-[1120px] overflow-hidden border-x border-[#E8E8E5]">
        <div class="flex items-center justify-between px-10 py-6 text-[13px] text-[#71717A]">
          <span>© 2026 Stash</span>
          <span class="flex gap-5"><a href="/blog/">Blog</a><a href="/privacy.html">Privacy</a><a href="/terms.html">Terms</a></span>
        </div>
        <FooterWordmark />
      </div>
    </footer>
  </div>
</Base>
