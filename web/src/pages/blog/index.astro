---
import Blog from '../../layouts/Blog.astro'
import { allPosts, SITE } from '../../lib/posts'

const posts = await allPosts()
const fmt = (d: Date) => d.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Stash blog',
  url: `${SITE}/blog/`,
  blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.title, url: `${SITE}/blog/${p.id}/`, datePublished: p.data.date.toISOString() })),
}]
---
<Blog title="Blog — Stash" description="What changed in Stash, written from every push to the repo." path="/blog/" jsonLd={jsonLd}>
  <Fragment slot="hero">
    <h1 class="text-[44px] font-medium leading-none tracking-[-0.03em] md:text-[64px]">Blog</h1>
    <p class="mt-4 max-w-[520px] text-[17px] text-white/80">What changed in Stash, drafted from every push to the repo.</p>
  </Fragment>
  <ul class="grid gap-4">
    {posts.map((p) => (
      <li>
        <a href={`/blog/${p.id}/`} class="block overflow-hidden rounded-[20px] border border-[#E8E8E5] bg-white transition-colors hover:border-[#C9C9C4]">
          {p.data.cover && <img src={p.data.cover} alt="" width="1200" height="630" loading="lazy" class="block h-auto w-full border-b border-[#E8E8E5]" />}
          <div class="p-6">
          <time datetime={p.data.date.toISOString()} class="text-[12px] font-medium uppercase tracking-wider text-[#71717A]">{fmt(p.data.date)}</time>
          <h2 class="mt-2 text-[22px] font-medium tracking-[-0.01em]">{p.data.title}</h2>
          <p class="mt-2 text-[15px] leading-[1.55] text-[#52525B]">{p.data.description}</p>
          </div>
        </a>
      </li>
    ))}
    {posts.length === 0 && <li class="text-[#71717A]">No posts yet.</li>}
  </ul>
</Blog>
